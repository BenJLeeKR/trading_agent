# SPPV-3 OOS 일봉 cache 배치 — 거래일 21:00 KST 근처 1회 트리거 timer 템플릿.
#
# 이 timer는 "거래일인지"를 모른다 — 매일(주말 포함) 21:00 KST에
# 무조건 서비스를 깨우고, 실제 거래일 판정은 컨테이너 내부
# `run_sppv3_oos_batch.py`(MarketSessionProvider.is_trading_day())가
# 최종 수행한다. 이렇게 나눈 이유: timer 설정에 거래일 캘린더 로직을
# 넣지 않아야 systemd 설정과 애플리케이션 코드의 거래일 판정이 서로
# 어긋날 위험이 없다 — 판정은 항상 코드 쪽 단일 소스(SSOT)로 유지한다.
#
# **이 파일은 템플릿이다.** 실제 설치는 사용자 승인 후
# `ops/systemd/install_sppv3_oos_batch_systemd.sh`가 명시적으로
# 실행됐을 때만 이뤄진다.
#
# ---------------------------------------------------------------------
# Persistent=true 채택 근거(설계 문서 §45.6/§4 확장, 요청받은 검토):
# ---------------------------------------------------------------------
# 서버가 21:00 KST 시점에 꺼져 있었다면 Persistent=true는 부팅 직후
# "놓친 타이머"를 즉시 1회 만회 실행한다. 이 만회 실행이 OOS 계약을
# 깨지 않는 이유:
#
#   1. `run_sppv3_oos_batch.py`는 target_trade_date를 "타이머가 원래
#      예정됐던 날짜"가 아니라 **실행 시점의 KST 오늘 날짜**로 계산한다
#      (스케줄 시각을 기억해 과거 날짜를 소급 수집하지 않는다 — 데이터를
#      실제로 존재하지 않았던 시점에 수집한 것처럼 조작하지 않기
#      위함이다).
#   2. 그 wrapper는 자체적으로 EARLIEST_RUN_TIME_KST(21:00) 시간
#      가드를 다시 검사한다. 그러므로:
#      - 서버가 같은 날 21:00~24:00 사이에만 잠깐 꺼졌다 켜진 경우
#        (예: 21:40 재부팅) → 만회 실행이 21:00 이후이므로 정상적으로
#        오늘 거래일 데이터를 수집한다. 안전하다.
#      - 서버가 다음날 새벽~낮에 켜진 경우(예: 자정 이후 재부팅)
#        → 만회 실행 시점의 KST 시각이 21:00 미만이므로 시간 가드에
#        걸려 `skip_time_gate_not_open`으로 조용히 종료한다. 그리고
#        새 날짜의 정규 21:00 timer가 그날 걸 정상적으로 수집한다.
#        **결과적으로 놓친 날짜의 OOS 표본은 채워지지 않고 그대로
#        구멍으로 남는다** — 이는 의도된 동작이다(과거 날짜를 오늘
#        수집한 것처럼 속이지 않는다는 원칙이 우선한다).
#   3. 즉 Persistent=true는 "같은 날 재부팅" 케이스에서만 실질적으로
#      동작하고, "날짜가 넘어간 재부팅" 케이스에서는 wrapper의 자체
#      가드 덕분에 안전하게 무해화(no-op)된다. 두 경우 모두 base
#      cache나 이전 성공 cache를 건드리지 않는다.
#
# 결론: Persistent=true를 채택한다. 표본 축적 gap이 생기는 쪽(놓친
# 날짜를 그냥 비움)이, 실제 수집 시점과 다른 날짜로 데이터를 소급
# 기록하는 쪽보다 이 연구 트랙의 재현성 원칙에 더 부합한다.

[Unit]
Description=SPPV-3 OOS bar cache daily batch timer (weekday-agnostic — trading-day check happens in the container)

[Timer]
# systemd v239+ 문법: 타임존을 OnCalendar 표현식 안에 명시할 수 있다.
# 호스트 시스템 타임존 설정과 무관하게 항상 KST 21:00을 기준으로 삼는다.
OnCalendar=Asia/Seoul *-*-* 21:00:00
Persistent=true
# 여러 인스턴스가 겹쳐 큐잉되는 것을 방지 — 어차피 wrapper 자체
# 파일 lock(flock)도 있지만, systemd 레벨에서도 이중으로 방어한다.
AccuracySec=1min

[Install]
WantedBy=timers.target
