# SPPV-3 OOS 일봉 cache 일 1회 자동 수집 배치 — systemd oneshot 서비스 템플릿.
#
# docs/40_action_plans/sppv3_oos_daily_batch_design_2026-08-25.md §4/§45가
# 정한 아키텍처를 그대로 반영한다. 실제 거래일/시간 판정은 이 서비스가
# 아니라 `scripts/run_sppv3_oos_batch.py` wrapper가 컨테이너 내부에서
# 최종 수행한다 — 이 unit은 "그 컨테이너를 21:00 KST 근처에 1회 깨우는"
# 역할만 한다(정확한 거래일 여부는 wrapper가 스스로 다시 판정하므로,
# systemd timer가 주말/휴장일을 몰라도 안전하다).
#
# **이 파일은 템플릿이다.** `/etc/systemd/system/`에 실제로 설치·
# daemon-reload·enable·start하는 행위는 `ops/systemd/install_sppv3_
# oos_batch_systemd.sh`가 수행하되, 그 스크립트 자체도 사용자가 명시적
# 승인 후 별도로 실행해야 한다 — 이 저장소의 어떤 CI/CD 경로도 이 파일을
# 자동으로 설치하지 않는다.
#
# 설치 시 아래 자리표시자를 실제 값으로 치환해야 한다(설치 스크립트가
# 자동 치환):
#   __AGENT_TRADING_REPO_ROOT__  — 운영 checkout 절대경로
#                                  (예: /workspace/agent_trading — 이
#                                  개발 checkout(agent_trading_dev)이
#                                  아니라 CI가 실제로 배포하는 운영
#                                  checkout을 가리켜야 한다)
#
# 2026-08-26 정정 — __DOCKER_COMPOSE_BIN__ 자리표시자를 제거했다
# (§48 후속). 초판은 `ExecStart`가 `docker compose`를 직접 호출했는데,
# 이 경로는 저장소 표준 배포 래퍼(`scripts/harness/docker_compose_
# env.sh`)를 거치지 않아 `/etc/agent_trading/*.env`(KIS live-info
# 자격증명 포함)가 Compose interpolation에 전혀 전달되지 않는
# 결함이었다 — 그대로 설치했다면 `KIS_LIVE_INFO_APP_KEY` 등이 빈
# 문자열로 치환돼, 배치가 매일 조용히 `skip_market_calendar_
# unavailable`만 반복하고 실제로는 절대 동작하지 않았을 것이다.
# 지금은 `docker_compose_env.sh`가 내부적으로 PATH에서 `docker`를
# 찾아 그대로 `exec`하므로, 이 unit이 별도로 compose 바이너리 경로를
# 알 필요가 없다 — 그래서 `__DOCKER_COMPOSE_BIN__` placeholder 자체가
# 불필요해졌다.

[Unit]
Description=SPPV-3 OOS bar cache daily batch (one-shot, read-only KIS historical daily bar)
# 주문 ops-scheduler와 완전히 독립 — 어떤 관계도 선언하지 않는다
# (After/Requires로 ops-scheduler에 묶지 않는다: 이 배치의 실패가
# 주문 경로 기동/재기동에 영향을 주면 안 되고, 그 반대도 마찬가지다).
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__AGENT_TRADING_REPO_ROOT__
# systemd 서비스는 로그인 셸이 아니라 이 PATH를 명시적으로 지정하지
# 않으면 배포 환경에 따라 `docker`가 없는 최소 PATH로 뜰 수 있다 —
# 표준 위치를 명시해 "PATH에 docker가 없어서 실패"를 구조적으로
# 방지한다(systemd.exec(5) 기본 PATH와 동일한 값).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# `docker exec`로 실행 중인 컨테이너에 진입하지 않는다 — 반드시
# `compose run --rm`(ephemeral one-shot 컨테이너)만 쓴다. 이 서비스가
# ops-scheduler 컨테이너 안에서 실행되는 일은 구조적으로 없다.
#
# `docker compose`를 직접 부르지 않고 반드시 저장소 표준 배포 래퍼
# `scripts/harness/docker_compose_env.sh`를 경유한다 — 이 래퍼가
# `/etc/agent_trading/*.env`(KIS live-info 자격증명 포함)를
# `--env-file`로 명시 전달해야만 Compose가 `${KIS_LIVE_INFO_APP_KEY}`
# 등을 올바르게 치환한다(scripts/harness/README.md "Docker/배포 표준
# 명령"). `--profile sppv3-oos-batch`를 명시해야 profile로 격리된 이
# 서비스가 `run` 대상에 인식된다. 절대경로(`/bin/bash`, repo-root
# 기준 절대경로 스크립트)를 사용해 systemd의 최소 PATH·상대경로
# 해석 문제를 모두 피한다.
ExecStart=/bin/bash __AGENT_TRADING_REPO_ROOT__/scripts/harness/docker_compose_env.sh --profile sppv3-oos-batch run --rm sppv3-oos-batch
# 전체 timeout — wrapper 자체 timeout(기본 1800초)보다 여유를 둔다.
TimeoutStartSec=2400
# 실패해도 systemd 레벨에서 자동 재시작하지 않는다 — 재시도는 다음날
# timer가 다시 트리거할 때, wrapper 자신의 idempotent skip/retry 로직
# (§45.2/45.4)에 맡긴다. 즉시 재시작은 KIS에 짧은 시간 내 반복 호출을
# 유발할 수 있어 의도적으로 금지한다.
Restart=no

[Install]
WantedBy=multi-user.target
