# =============================================================================
# Agent Trading System — Local Development Environment Template
# =============================================================================
# Copy this file to .env and adjust values for your local setup.
#   cp .env.example .env
#
# NEVER commit the actual .env file to version control.
# =============================================================================

# ---- Application -----------------------------------------------------------
APP_ENV=live
APP_TIMEZONE=Asia/Seoul

# ---- Scheduler -------------------------------------------------------------
# 일반 BUY lane 하루 제출 상한.
# ops-scheduler는 이 값을 읽어 `--max-general-buy-submit-per-day`로 전달한다.
# 설정하지 않으면 docker-compose 기본값 6을 사용.
SCHEDULER_MAX_GENERAL_BUY_SUBMIT_PER_DAY=6
#
# 참고:
# - `MAX_GENERAL_BUY_SUBMIT_PER_DAY` 는 현재 읽지 않는다.
# - `--max-submit-per-day` 는 deprecated alias 이며, 새 기준 이름은
#   `--max-general-buy-submit-per-day` / `SCHEDULER_MAX_GENERAL_BUY_SUBMIT_PER_DAY` 이다.
#
# decision_submit_gate 배치(신규 진입/보유 포지션 판단) 실행 간격(초).
# 설정하지 않으면 기본값 600초(10분)를 사용한다. 0 이하이거나 정수가 아니면
# 무효 값으로 간주해 동일하게 600초로 fallback한다.
OPS_SCHEDULER_DECISION_INTERVAL_SECONDS=600

# ---- §21 gate override -----------------------------------------------------
# paper/shadow 관측 단계에서만 명시적으로 켠다.
# - true: §21 gate를 우회해 R3b BUY 후보가 실제 판단 경로를 통과할 수 있음
# - false: 캐시된 trigger_status를 그대로 반영 (현재 NOT_TRIGGERED면 BUY 차단 가능)
# production 전환 전에는 다시 false로 복귀하는 것을 기본 원칙으로 둔다.
REGIME_SWITCH_V1_GATE_OVERRIDE_ENABLED=false
#
# ---- core_risk_off top-k apply override ------------------------------------
# risk_off 레짐(§`core_risk_off` authoritative guard)에서 top-k로 선택된
# 소수 종목에 한해 ranking/activity 완화 예외를 실제로 적용할지 여부.
# `scripts/run_decision_loop.py`가 이 값을 읽는다(문자열 "1"일 때만 활성).
# - 1: 활성(top-k 예외 적용)
# - 0: 비활성(코드 기본값, override 없이 authoritative guard만 적용)
DETERMINISTIC_TRIGGER_APPLY_CORE_RISK_OFF_TOPK=0

# ---- R3b alpha entry_score switch ------------------------------------------
# entry_score의 alpha 항을 기존 composite 대신 R3b candidate_percentile로 교체한다.
# - true: cycle precompute가 계산한 `r3b_alpha_percentile`을 사용해
#   alpha 항을 `0.80 * candidate_percentile`로 대체
# - false: 기존 entry_score alpha 공식 유지
# 이 값만 true여도 충분하지 않다. benchmark(069500) signal_feature_snapshot이
# 실제로 배치되어 있어야 precompute가 빈 dict로 끝나지 않고 발동한다.
ENTRY_SCORE_R3B_ALPHA_ENABLED=false
#
# ---- expected_value_gate near-miss 조건부 완화 (SPPV-2.87/2.88) -----------
# 전역 minimum_required_edge_bps나 EV 계산 로직은 전혀 바꾸지 않는다.
# 아래 5개 조건을 모두 만족하는 매우 좁은 경우에 한해
# expected_value_gate_passed=false를 예외적으로 제출 허용 처리한다:
#   1. decision_type in {APPROVE, BUY}
#   2. expected_value_gate_passed == false
#   3. minimum_required_edge_bps - edge_after_cost_bps <= 2.0bps
#   4. source_type == "core"
#   5. deterministic_trigger.reason_codes에 trigger_r3b_alpha_percentile 포함
# - true: 위 조건을 모두 만족하는 경우에만 near-miss override 적용
# - false(기본값): 기존 동작과 100% 동일
EV_GATE_NEAR_MISS_OVERRIDE_ENABLED=false
#
# ---- 손실률 기반 Loss-cut shadow 관측 (설계 문서 §3.6) ----
# 이 3개 값은 **관측 전용**이다 — true여도 decision_type/side/주문
# 제출 어디에도 개입하지 않는다. 정식 운영 loss-cut 정책값은 이
# env가 아니라 `config_versions` + Admin API/CLI로 관리한다(§4,
# `risk.max_single_position_pct` 선례와 동일 원칙) — 절대 이 env
# 이름을 정책값으로 오인해 실주문 경로에 연결하지 말 것. 이름에
# 항상 `SHADOW`가 들어가는 것 자체가 "이건 관측 전용"이라는 표시다.
# - true: `position_snapshot.quantity > 0`인 모든 결정 사이클에서
#   loss-cut 가상 판정을 계산해 `trade_decisions.decision_json.
#   loss_cut_shadow`에 기록
# - false(기본값): 계산 자체를 하지 않음, 기존 동작과 100% 동일
LOSS_CUT_SHADOW_ENABLED=false
# soft/hard 임계치(%) — 관측 전용 threshold. 정식 정책 확정 전
# 임시값이며, 실측 뒤 `config_versions`의 `risk.loss_cut.*`로
# 이전한다(설계 문서 §5 B2/B3 참고).
LOSS_CUT_SHADOW_SOFT_THRESHOLD_PCT=7
LOSS_CUT_SHADOW_HARD_THRESHOLD_PCT=12
#
# ---- core universe(decision_loop_intraday) 크기 상한 ---
# R3b candidate pool의 실제 모수(core_cap)를 결정한다 — 이 값이 작을수록
# 20% quintile로 뽑히는 candidate pool도 작아지고, percentile이 이산적으로
# ({0.0,1.0} 등) 튀는 현상이 심해진다(§80/§83). 코드 diff 없이 이 값만
# 올리면 candidate pool 모수를 넓힐 수 있다(§90/§91에서 실측 확인).
# 기본값 12(scripts/run_decision_loop.py의 DEFAULT_TRADING_UNIVERSE_
# CORE_CAP과 동일) — 40으로 올리면 pool 크기가 대략 2~3배 커진다(실측
# 기준 2→8). 신규 진입 종목의 하류(eligibility/EV gate) 상태는 이
# 값만으로는 보장되지 않으며 별도 관찰이 필요하다.
TRADING_UNIVERSE_CORE_CAP=40

# ---- universe 전체(non-held) 상한(SPPV-2.110) ---
# `_load_trading_universe_with_anchor()`의 CompositionContext.max_cap을
# 결정한다 — core_cap이 아무리 커도(예: 60) 실제 universe 크기는 이 값을
# 넘지 못한다(순위 기준 상위 max_cap개만 진입). 기본값 30(코드 기본값과
# 동일, SPPV-2.107/2.108/2.109에서 하드코딩임을 확인). 이 값만 올리면
# core_cap이 열어준 하위 순위 후보(예: 009150, rank 60)가 실제 runtime
# universe에 진입할 수 있다 — 단, eligibility/층3(AI downgrade) 통과는
# 별도로 관찰해야 한다(SPPV-2.110).
TRADING_UNIVERSE_MAX_CAP=30

# ---- Korea Investment & Securities (KIS) ----------------------------------
# Preferred naming (한국투자증권 actual standard):
KIS_ENV=paper           # "paper" | "real" (normalized to "live" internally)
KIS_APP_KEY=""
KIS_APP_SECRET=""
KIS_ACCOUNT_NO=""
KIS_ACCOUNT_PRODUCT_CODE=01
#
# REST rate limit safety budget baseline (env override):
# KIS official notice 2026-04-20: 실전 REST 계좌당 초당 18건, 모의 초당 1건
KIS_REAL_REST_RPS=18
KIS_PAPER_REST_RPS=1
#
# Dev token cache (paper/dev only — live/real에서는 무시됨):
# 파일 기반 access token 캐시로 프로세스 간 토큰 재사용.
KIS_DEV_TOKEN_CACHE_ENABLED=true
KIS_DEV_TOKEN_CACHE_PATH=.cache/kis_token.json
KIS_LIVE_TOKEN_CACHE_ENABLED=true
KIS_LIVE_TOKEN_CACHE_PATH=.cache/kis_live_token.json
#
# Live market-info/read-only client (scheduler session gate / holiday lookup)
KIS_LIVE_INFO_ENABLED=true
KIS_LIVE_INFO_APP_KEY=""
KIS_LIVE_INFO_APP_SECRET=""
KIS_LIVE_INFO_BASE_URL="https://openapi.koreainvestment.com:9443"
KIS_LIVE_INFO_WS_URL="ws://ops.koreainvestment.com:21000"
#
# Realtime-quote screen client legacy examples
# KIS_REALTIME_QUOTE_APP_KEY=""
# KIS_REALTIME_QUOTE_APP_SECRET=""
# KIS_REALTIME_QUOTE_BASE_URL="https://openapi.koreainvestment.com:9443"
# KIS_REALTIME_QUOTE_WS_URL="ws://ops.koreainvestment.com:21000"

# ---- PostgreSQL (primary DATABASE_* prefix) --------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trading
DATABASE_USER=trading
DATABASE_PASSWORD=
DATABASE_SCHEMA=trading

# ---- PostgreSQL (backward-compatible DB_* fallback) ------------------------
# These are supported but DATABASE_* takes precedence when both are set.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trading
# DB_USER=trading
# DB_PASSWORD=trading

# ---- Provider AI (DeepSeek / OpenAI-compatible) ----------------------------
# LLM_PROVIDER controls which set of env vars is read.
# Supported values: deepseek (default), openai, gemini
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120

# --- Gemini Configuration Example ---
# To use Gemini API (Recommended: gemini-2.5-flash for best speed/accuracy balance)
# LLM_PROVIDER=gemini
GEMINI_API_KEY=""
# To use the OpenAI-compatible endpoint with Gemini:
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL_ID="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=120

# --- OpenAI Configuration Example ---
# To switch to OpenAI, set LLM_PROVIDER=openai and uncomment:
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL_ID="gpt-4o"
# OPENAI_TIMEOUT_SECONDS=30

# ---- OpenDART Open API Key -------------------------------------------------
OPENDART_API_KEY=""

# ---- Naver News Search API Key ---------------------------------------------
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ---- FastAPI inspection/admin API Token ------------------------------------
INSPECTION_API_TOKEN=""

# ---- CORS(Cross-Origin Resource Sharing) -----------------------------------
CORS_ALLOWED_ORIGINS=

# ---- Frontend 빌드 시 주입되는 백엔드 origin (특수 배포 전용, 보통은 비워둔다) ---
# 비워두면 코드 기본값(`/api`, 상대경로)을 쓴다.
VITE_API_BASE_URL=
